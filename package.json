{
  "name": "@okbawiss/fastscan",
  "version": "1.0.1",
  "description": "Hardware-accelerated, zero-copy systems file scanner for Node.js powered by AVX-512/AVX2 SIMD, kernel mmap, and persistent thread pools.",
  "main": "src/index.js",
  "bin": {
    "fastscan": "./cli.js"
  },
  "scripts": {
    "install": "node-gyp rebuild",
    "build": "node-gyp build",
    "rebuild": "node-gyp rebuild",
    "test": "node test/api.test.js",
    "benchmark": "node benchmarks/benchmark.js",
    "generate-data": "node generate-data.js",
    "clean": "node-gyp clean"
  },
  "keywords": [
    "scanner",
    "grep",
    "mmap",
    "simd",
    "avx-512",
    "avx2",
    "neon",
    "zero-copy",
    "thread-pool",
    "high-performance",
    "cybersecurity",
    "threat-hunting",
    "log-analysis",
    "forensics",
    "native-addon",
    "napi",
    "c",
    "cli"
  ],
  "author": "GUIAR OQBA <contact@guiarx.com> (https://guiarx.com/)",
  "license": "MIT",

  "engines": {
    "node": ">=18"
  },

  "os": [
    "linux",
    "darwin",
    "win32"
  ],

  "cpu": [
    "x64"
  ],

  "repository": {
    "type": "git",
    "url": "git+https://github.com/okba14/FastScan.git"
  },
  "bugs": {
    "url": "https://github.com/okba14/FastScan/issues"
  },
  "homepage": "https://github.com/okba14/FastScan#readme",

  "dependencies": {
    "bindings": "^1.5.0"
  },

  "devDependencies": {
    "node-gyp": "^13.0.2"
  },

  "gypfile": true,

  "files": [
    "src/",
    "native/",
    "cli.js",
    "binding.gyp",
    "README.md",
    "LICENSE"
  ],

  "overrides": {
    "tar": "^7.5.22"
  }
}
